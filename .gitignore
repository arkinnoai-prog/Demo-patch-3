# Secrets — never commit.
.env
.env.*
!.env.example
*.pem
*.key

# Local state
data/
*.db
*.sqlite3
ci-manifest.yaml

# Scanner output — regenerated by scan.yml on every run
trivy-*.json
trivy-*.sarif
pip-audit.json
bandit.json
ingest-summary.json
sbom-*.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.eggs/
build/
dist/
# requirements.txt is this repo's lock (every pin is ==); pyproject keeps [project].dependencies
# empty on purpose, so a generated uv.lock would lock nothing and mislead. See pyproject.toml.
uv.lock

# Test / coverage
.pytest_cache/
.coverage
coverage.xml
htmlcov/
junit*.xml
.ruff_cache/

# Node / frontend (React + Vite)
node_modules/
frontend/node_modules/
frontend/dist/
npm-debug.log*
yarn-error.log*
.vite/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
