# Copy to .env for local development.  .env is gitignored and must never be committed —
# POC-PLAN.md Prerequisites item 5 exists because that is an easy mistake to make.

# test | staging | production | local
APP_ENV=local

# Persistence — PostgreSQL everywhere, no SQLite fallback.
#   local  — the dev server from docker-compose:  docker compose up -d postgres
#   Azure  — the SHARED PostgreSQL Flexible Server, which is also what makes the
#            impact-analysis blast radius real (POC-PLAN.md §1)
# Leaving this unset uses the same localhost dev-server default the app ships with.
DATABASE_URL=postgresql+psycopg2://baobao:localdev@localhost:5432/baobao

# Ba0Ba0 control plane.  Leave blank to run purely locally: the job still ingests,
# normalises and persists, it just posts nothing.
BAOBAO_INGEST_URL=
# BAOBAO_INGEST_URL=http://localhost:3000/api/ingest/scanner

# Local-development convenience only.  In CI the ingest call authenticates with
# GitHub's own OIDC token (audience api://baobao); in Azure, with the managed identity.
# There is no shared secret in either path (POC-PLAN.md §4).
BAOBAO_TOKEN=

BAOBAO_TIMEOUT_SECONDS=15
BAOBAO_BATCH_SIZE=50
BAOBAO_MAX_RETRIES=3

JOB_MANIFEST=samples/job-manifest.yaml
WORKER_DATA_DIR=data
LOG_LEVEL=INFO

# Set by deploy-revision.sh from the built image tag; surfaced on /healthz so the smoke
# test can prove the new revision is actually the one serving.
IMAGE_TAG=dev

# Skip the control-plane POST without unsetting BAOBAO_INGEST_URL.
DRY_RUN=false
